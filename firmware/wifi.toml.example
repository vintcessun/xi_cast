# 复制成 wifi.toml 再填自己的。wifi.toml 已经在 .gitignore 里，不会被提交。

ssid     = "你家的WiFi名字"
password = "你家的WiFi密码"

# ── 电视怎么找（三选一，从推荐到不推荐）────────────────────────

# ① 推荐：只给电视的 IP（在路由器里给它绑一个固定 IP）。
#
# 板子只跟这一个 IP 打交道：先单播问它要设备描述地址，问不到再试几个
# 常见端口。端口和路径不用你操心，板子自己问。
#
# 关键好处是**全程不发组播**，所以绝不可能把戏投到邻居家的盒子上
# —— 组播是不认门牌号的。
tv_ip = "192.168.0.100"

# ② 连端口和路径都写死（一般不用，除非 ① 那几个常见端口都试不中）。
#   地址从开机日志里抄，形如 http://<IP>:<端口>/xxx.xml
#tv_url = "http://192.168.0.100:49152/description.xml"

# ③ 两个都不填 = 开机 SSDP 广播扫描，扫到第一台能投的就用。
#   省事，但理论上可能扫到邻居家的设备。

# ── 下面是对付「2.4G 和 5G 同名」的，一般用不上 ──────────────

# 只连指定的 AP（写它的 BSSID）。
#
# ESP32 只有 2.4G，有些路由器的 band steering 会把它往 5G 上赶，
# 表现是连上一下又被踢。填上 2.4G 那个射频的 MAC，板子就只认它，
# 不用改路由器任何设置。
#
# 值从开机日志里抄：那段 WiFi 扫描会把每个 AP 的 BSSID、信道、信号都打出来，
# 带 ★ 的就是你要的那个。
#bssid = "bc:54:fc:26:3a:3b"

# 只连指定信道（2.4G 是 1~13）。填了 bssid 一般就不用再填这个。
#channel = 6
